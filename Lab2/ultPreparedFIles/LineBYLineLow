// Reads from fd until newline or buffer full.
// Returns: Number of bytes read.
ssize_t read_line(int fd, char *buf, size_t size) {
    ssize_t n = 0;
    char c;
    while (n < size - 1) {
        // Read 1 byte
        ssize_t res = TEMP_FAILURE_RETRY(read(fd, &c, 1));
        
        if (res < 0) return -1;     // Error
        if (res == 0) break;        // EOF (End of File)
        
        buf[n++] = c;               // Store char
        if (c == '\n') break;       // Stop at newline
    }
    buf[n] = '\0'; // Add null terminator for string safety
    return n;
}